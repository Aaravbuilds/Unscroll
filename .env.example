# DeepSeek runs on OpenRouter's servers — nothing to install locally.
# Create a key at https://openrouter.ai/settings/keys and paste it below.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Local dev server (npm run dev). Ignored by Cloudflare deployments.
PORT=8787
# Requests per minute per IP. Default 3; raise it only for local testing.
RATE_LIMIT_PER_MINUTE=3